                      "name": "lab-secrets",
                      "key": "APP_KEY"
                    }
                  }
                },
                {
                  "name": "DB_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "lab-secrets",
                      "key": "DB_PASSWORD"
                    }
                  }
                },
                {
                  "name": "REDIS_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "lab-secrets",
                      "key": "REDIS_PASSWORD"
