  "deployment-worker": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "worker",
      "namespace": "lab"
    },
    "spec": {
      "replicas": 2,
      "strategy": {
        "type": "RollingUpdate"
      },
      "selector": {
        "matchLabels": {
          "app": "worker"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "worker"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "worker",
              "image": "laravel-reliability-app:g1",
              "imagePullPolicy": "IfNotPresent",
              "ports": [
                {
                  "containerPort": 8080,
                  "name": "http"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
