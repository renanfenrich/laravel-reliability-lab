                    }
                  }
                },
                {
                  "name": "LAB_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "lab-secrets",
                      "key": "LAB_TOKEN"
                    }
                  }
                },
                {
                  "name": "APP_ENV",
                  "value": "local"
                },
                {
                  "name": "LAB_FAULTS",
                  "value": "true"
                },
                {
                  "name": "DB_HOST",
                  "value": "postgres"
                },
                {
                  "name": "REDIS_HOST",
                  "value": "redis"
                },
                {
                  "name": "SIMULATOR_URL",
                  "value": "http://simulator:8081"
                },
                {
                  "name": "LAB_ROLE",
                  "value": "scheduler"
                }
              ],
              "volumeMounts": [
                {
                  "name": "storage",
                  "mountPath": "/app/storage"
                },
                {
                  "name": "cache",
                  "mountPath": "/app/bootstrap/cache"
                },
                {
                  "name": "tmp",
                  "mountPath": "/tmp"
                }
              ],
              "startupProbe": {
                "exec": {
                  "command": [
                    "php",
                    "artisan",
                    "lab:ready"
                  ]
                },
                "failureThreshold": 60,
                "periodSeconds": 3,
                "timeoutSeconds": 2
              },
              "readinessProbe": {
                "exec": {
                  "command": [
                    "php",
                    "artisan",
                    "lab:ready"
                  ]
                },
                "periodSeconds": 5,
                "timeoutSeconds": 3
              },
              "livenessProbe": {
                "exec": {
                  "command": [
                    "php",
                    "-r",
                    "exit(str_contains(file_get_contents('/proc/1/cmdline'), 'artisan') ? 0 : 1);"
                  ]
                },
                "periodSeconds": 10,
                "failureThreshold": 3
              }
            }
          ],
          "terminationGracePeriodSeconds": 25,
          "automountServiceAccountToken": false,
          "securityContext": {
            "seccompProfile": {
              "type": "RuntimeDefault"
            },
            "fsGroup": 1000
          },
          "volumes": [
            {
              "name": "storage",
              "emptyDir": {}
            },
            {
              "name": "cache",
              "emptyDir": {}
            },
            {
              "name": "tmp",
              "emptyDir": {}
            }
          ],
          "initContainers": [
            {
              "name": "storage-init",
              "image": "laravel-reliability-app:g1",
              "imagePullPolicy": "IfNotPresent",
              "command": [
                "sh",
                "-c",
                "mkdir -p /app/storage/framework/cache /app/storage/framework/views /app/storage/framework/sessions /app/storage/logs"
              ],
              "volumeMounts": [
                {
                  "name": "storage",
                  "mountPath": "/app/storage"
                },
                {
                  "name": "cache",
                  "mountPath": "/app/bootstrap/cache"
                },
                {
                  "name": "tmp",
                  "mountPath": "/tmp"
                }
              ],
              "securityContext": {
                "runAsUser": 1000,
                "runAsNonRoot": true,
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  },
  "service-scheduler": {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "scheduler",
      "namespace": "lab"
    },
    "spec": {
      "selector": {
        "app": "scheduler"
      },
      "ports": [
        {
          "port": 8080,
          "targetPort": 8080,
          "name": "http"
        }
      ]
    }
  },
  "deployment-exporter": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "exporter",
      "namespace": "lab"
    },
    "spec": {
      "replicas": 1,
      "strategy": {
        "type": "RollingUpdate"
      },
      "selector": {
        "matchLabels": {
          "app": "exporter"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "exporter"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "exporter",
              "image": "laravel-reliability-app:g1",
              "imagePullPolicy": "IfNotPresent",
              "ports": [
                {
                  "containerPort": 8080,
                  "name": "http"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
                "limits": {
                  "cpu": "1",
                  "memory": "384Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsUser": 1000,
                "runAsNonRoot": true
              },
              "command": [
                "php",
                "-S",
                "0.0.0.0:8080",
                "-t",
                "public",
                "public/index.php"
              ],
              "env": [
                {
                  "name": "APP_KEY",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "lab-secrets",
                      "key": "APP_KEY"
                    }
                  }
                },
                {
                  "name": "DB_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "lab-secrets",
                      "key": "DB_PASSWORD"
                    }
                  }
                },
                {
                  "name": "REDIS_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "lab-secrets",
                      "key": "REDIS_PASSWORD"
                    }
                  }
                },
                {
                  "name": "LAB_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "lab-secrets",
                      "key": "LAB_TOKEN"
                    }
                  }
                },
                {
                  "name": "APP_ENV",
                  "value": "local"
                },
                {
                  "name": "LAB_FAULTS",
                  "value": "true"
                },
                {
                  "name": "DB_HOST",
                  "value": "postgres"
                },
                {
                  "name": "REDIS_HOST",
                  "value": "redis"
                },
                {
                  "name": "SIMULATOR_URL",
                  "value": "http://simulator:8081"
                },
                {
                  "name": "LAB_ROLE",
                  "value": "exporter"
                }
              ],
              "volumeMounts": [
                {
                  "name": "storage",
                  "mountPath": "/app/storage"
                },
                {
                  "name": "cache",
                  "mountPath": "/app/bootstrap/cache"
                },
                {
                  "name": "tmp",
                  "mountPath": "/tmp"
                }
              ],
              "startupProbe": {
                "httpGet": {
                  "path": "/api/ready",
                  "port": 8080
                },
                "failureThreshold": 60,
                "periodSeconds": 3,
                "timeoutSeconds": 2
              },
              "readinessProbe": {
                "httpGet": {
                  "path": "/api/ready",
                  "port": 8080
                },
                "periodSeconds": 5,
                "timeoutSeconds": 3
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/api/live",
                  "port": 8080
                },
                "periodSeconds": 10,
                "failureThreshold": 3
              }
            }
          ],
          "terminationGracePeriodSeconds": 25,
          "automountServiceAccountToken": false,
          "securityContext": {
            "seccompProfile": {
              "type": "RuntimeDefault"
            },
            "fsGroup": 1000
          },
          "volumes": [
            {
              "name": "storage",
              "emptyDir": {}
            },
            {
              "name": "cache",
              "emptyDir": {}
            },
            {
              "name": "tmp",
              "emptyDir": {}
            }
          ],
          "initContainers": [
            {
              "name": "storage-init",
              "image": "laravel-reliability-app:g1",
              "imagePullPolicy": "IfNotPresent",
              "command": [
                "sh",
                "-c",
                "mkdir -p /app/storage/framework/cache /app/storage/framework/views /app/storage/framework/sessions /app/storage/logs"
              ],
              "volumeMounts": [
                {
                  "name": "storage",
                  "mountPath": "/app/storage"
                },
                {
                  "name": "cache",
                  "mountPath": "/app/bootstrap/cache"
                },
                {
                  "name": "tmp",
                  "mountPath": "/tmp"
                }
              ],
              "securityContext": {
                "runAsUser": 1000,
                "runAsNonRoot": true,
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  },
