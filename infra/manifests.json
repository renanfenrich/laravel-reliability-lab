          "terminationGracePeriodSeconds": 25,
          "automountServiceAccountToken": false,
          "securityContext": {
            "seccompProfile": {
              "type": "RuntimeDefault"
            },
            "fsGroup": 1000
          },
          "volumes": [
            {
              "name": "storage",
              "emptyDir": {}
            },
            {
              "name": "cache",
              "emptyDir": {}
            },
            {
              "name": "tmp",
              "emptyDir": {}
            }
          ],
          "initContainers": [
            {
              "name": "storage-init",
              "image": "laravel-reliability-app:g1",
              "imagePullPolicy": "IfNotPresent",
              "command": [
                "sh",
                "-c",
                "mkdir -p /app/storage/framework/cache /app/storage/framework/views /app/storage/framework/sessions /app/storage/logs"
              ],
              "volumeMounts": [
                {
                  "name": "storage",
                  "mountPath": "/app/storage"
                },
                {
                  "name": "cache",
                  "mountPath": "/app/bootstrap/cache"
                },
                {
                  "name": "tmp",
                  "mountPath": "/tmp"
                }
              ],
              "securityContext": {
                "runAsUser": 1000,
                "runAsNonRoot": true,
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  },
