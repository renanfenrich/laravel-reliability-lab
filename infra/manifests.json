                {
                  "name": "LAB_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "lab-secrets",
                      "key": "LAB_TOKEN"
                    }
                  }
                },
                {
                  "name": "APP_ENV",
                  "value": "local"
                },
                {
                  "name": "LAB_FAULTS",
                  "value": "true"
                },
                {
                  "name": "DB_HOST",
                  "value": "postgres"
                },
                {
                  "name": "REDIS_HOST",
                  "value": "redis"
                },
                {
                  "name": "SIMULATOR_URL",
                  "value": "http://simulator:8081"
                },
                {
                  "name": "LAB_ROLE",
                  "value": "worker"
                }
              ],
              "volumeMounts": [
                {
                  "name": "storage",
                  "mountPath": "/app/storage"
                },
                {
                  "name": "cache",
                  "mountPath": "/app/bootstrap/cache"
                },
                {
                  "name": "tmp",
                  "mountPath": "/tmp"
                }
              ],
              "startupProbe": {
                "exec": {
                  "command": [
                    "php",
                    "artisan",
                    "lab:ready"
                  ]
                },
                "failureThreshold": 60,
                "periodSeconds": 3,
                "timeoutSeconds": 2
              },
              "readinessProbe": {
                "exec": {
                  "command": [
                    "php",
                    "artisan",
                    "lab:ready"
                  ]
                },
                "periodSeconds": 5,
                "timeoutSeconds": 3
              },
              "livenessProbe": {
                "exec": {
                  "command": [
                    "php",
                    "-r",
                    "exit(str_contains(file_get_contents('/proc/1/cmdline'), 'artisan') ? 0 : 1);"
                  ]
                },
                "periodSeconds": 10,
                "failureThreshold": 3
              }
