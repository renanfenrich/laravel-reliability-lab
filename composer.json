{
  "name": "lab/laravel-reliability",
  "type": "project",
  "require": {
    "php": "~8.4.0",
    "laravel/framework": "13.34.0",
    "predis/predis": "3.2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "12.5.12",
    "mockery/mockery": "1.6.12"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.26"
    },
    "allow-plugins": false
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  }
}
