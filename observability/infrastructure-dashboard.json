{
  "uid": "lab-infrastructure",
  "title": "Lab \u2014 Sistema, Docker e Kubernetes",
  "description": "Recursos medidos do notebook e do projeto. Host inclui outros processos; kind inclui pods: nunca somar estas camadas. Docker CLI arredonda IO. Aus\u00eancia de tr\u00e1fego pode produzir s\u00e9ries vazias; consulte sa\u00fade de coleta. N\u00e3o representa produ\u00e7\u00e3o.",
  "schemaVersion": 39,
  "version": 3,
  "tags": [
    "local-lab",
    "infrastructure"
  ],
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
