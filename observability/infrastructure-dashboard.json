{
  "uid": "lab-infrastructure",
  "title": "Lab — Sistema, Docker e Kubernetes",
  "description": "Recursos medidos do notebook e do projeto. Host inclui outros processos; kind inclui pods: nunca somar estas camadas. Docker CLI arredonda IO. Ausência de tráfego pode produzir séries vazias; consulte saúde de coleta. Não representa produção.",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "local-lab",
    "infrastructure"
  ],
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Notebook inteiro — inclui outros processos; não atribuir tudo ao projeto",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Host CPU utilizada",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(lab_host_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "legendFormat": "{{container}}{{pod}}{{device}}{{interface}}{{kind}}{{minutes}}{{deployment}}{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
