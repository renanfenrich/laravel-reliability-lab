        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Host CPU utilizada",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(lab_host_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "legendFormat": "{{container}}{{pod}}{{device}}{{interface}}{{kind}}{{minutes}}{{deployment}}{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
